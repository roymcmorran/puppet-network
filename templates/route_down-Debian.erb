#!/bin/bash
#
### File managed by Puppet
#
if [ "$IFACE" = "<%= @interface -%>" ] || [ "$IFACE" = "--all" ]; then
<%- (0..(@ipaddress.length-1)).each do |id| -%>
  if [ "$ADDRFAM" = "<%- if !@family or ['inet4','inet'].include?(@family[id]) -%>inet<%- elsif @family and @family[id] == "inet6" -%>inet6<%- end -%>" ] ; then
    if ip<%- if @family and @family[id] == 'inet6' -%> -6<%- end -%> route show <%- if @table and @table[id] -%> table <%= @table[id] %><% end %> | grep -qP "<%= @ipaddress[id] %><%- if @_cidr and @_cidr[id] and ( ( ( !@family or @family[id] == 'inet4') and @_cidr[id] != 32 ) or ( @family and @family[id] == 'inet6' and @_cidr[id] != 128 ) ) -%>/<%= @_cidr[id] %><%- if ( ( ( !@family or @family[id] == 'inet4') and [ '0.0.0.0', 'default' ].include?(@ipaddress[id]) ) or ( @family and @family[id] == 'inet6' and [ '::', 'default', '0::' ].include?(@ipaddress[id]) ) ) and ( @_cidr[id] == 0 or @_cidr[id] == '0' ) %>|default<%- end %><%- end -%> "
    then
      ip<%- if @family and @family[id] == 'inet6' -%> -6<%- end -%> route del <%= @ipaddress[id] %>/<%= @_cidr[id] %><%- if @gateway and @gateway[id] -%> via <%= @gateway[id] %><%- end -%> dev <%= @interface %> <%- if @scope and @scope[id] -%> scope <%= @scope[id] %><%- end -%><%- if @source and @source[id] -%> src <%= @source[id] %><%- end -%><%- if @table and @table[id] -%> table <%= @table[id] %><% end %><%- if @metric and @metric[id] -%> metric <%= @metric[id] %><% end %><%- if @mtu and @mtu[id] -%> mtu <%= @mtu[id] %><% end %>
    fi
  fi
<%- end -%>
fi
